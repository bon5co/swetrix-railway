map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

# Railway's private network is DNS-resolved at runtime; a hostname baked into
# proxy_pass at startup would pin the address of whatever the API service was
# when this container booted.
resolver __RESOLVER__ valid=10s;

server {
  listen __LISTEN_PORT__ default_server;
  listen [::]:__LISTEN_PORT__ default_server;
  server_name _;

  client_max_body_size 32m;

  add_header X-XSS-Protection          "1; mode=block" always;
  add_header X-Content-Type-Options    "nosniff" always;
  add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy        "interest-cohort=()" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # /backend/ is the path the Swetrix UI calls in selfhosted mode; the API
  # itself serves those routes at the root, so the prefix has to come off.
  #
  # The prefix strip is done with an explicit rewrite, NOT by putting a `/` URI
  # on proxy_pass. When proxy_pass names a variable upstream, nginx does not do
  # its usual "replace the matched location prefix" rewrite — it replaces the
  # WHOLE request URI with the literal URI given. `proxy_pass http://$up/;`
  # therefore sends every /backend/* request upstream as `/`. Measured
  # 2026-08-02: POST /backend/v1/auth/login came back
  # {"message":"Cannot POST /","error":"Not Found"}.
  location /backend/ {
    set $swetrix_api "__API_UPSTREAM__";
    rewrite ^/backend/(.*)$ /$1 break;
    proxy_pass http://$swetrix_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;

    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_read_timeout                 300s;
    proxy_buffering                    on;
    proxy_buffer_size                  256k;
    proxy_buffers                      64 512k;
    proxy_busy_buffers_size            16m;
    proxy_temp_file_write_size         16m;
    proxy_max_temp_file_size           1024m;
  }

  location / {
    set $swetrix_frontend "127.0.0.1:__FRONTEND_PORT__";
    proxy_pass http://$swetrix_frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;

    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_buffering                    on;
    proxy_buffer_size                  256k;
    proxy_buffers                      64 512k;
    proxy_busy_buffers_size            16m;
    proxy_temp_file_write_size         16m;
    proxy_max_temp_file_size           1024m;
  }

  gzip            on;
  gzip_vary       on;
  gzip_proxied    any;
  gzip_comp_level 6;
  gzip_types      text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;
}
